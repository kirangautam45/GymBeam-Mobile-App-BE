# Copy to .env. Never commit the real .env file.

# development | staging | production
ENVIRONMENT=development

# Supabase Postgres: Project Settings > Database > Connection string (URI).
# Leave as SQLite to develop without touching the hosted database.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=sqlite:///./gymbeam.db

# Supabase Auth issues the access tokens this API verifies.
SUPABASE_URL=https://<project-ref>.supabase.co
# Optional, defaults to <SUPABASE_URL>/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=

# JSON list of browser origins allowed to call the API (only needed for Expo web).
CORS_ORIGINS=[]


